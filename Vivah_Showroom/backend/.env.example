# --- Server ---
PORT=5000
NODE_ENV=development

# --- PostgreSQL ---
# The ONE database for the whole app (users, products, orders, everything —
# see prisma/schema.prisma). This project used to also require a separate
# MongoDB Atlas connection; that's gone, this is now the only database URL
# needed. Get a free Postgres instance from Render, Railway, Neon, or Supabase.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/vivah_showroom?schema=public

# --- Auth ---
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# --- Email (Nodemailer) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Vivah Trousseau <hello@vivahtrousseau.com>"

# --- Cloudinary (recommended for production image hosting — required for
# uploaded images to survive a Render redeploy; without these set, uploads
# fall back to local disk storage which is fine for local dev only) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Admin panel (owner-only) ---
# Secret required to create a NEW admin account via POST /api/auth/admin-register.
# Share this with a new owner privately (phone/WhatsApp) when the business is
# sold — it lets them register their own admin email+password without ever
# needing the previous owner's credentials. Rotate/change it after each transfer.
ADMIN_SETUP_KEY=replace_with_a_long_random_secret

# How many hours a single admin login stays checked out before the
# single-admin-session lock auto-expires (safety net if someone forgets to
# log out — see prisma/schema.prisma's AdminLock model).
ADMIN_SESSION_HOURS=12

# --- Dual-OTP admin sign-in ---
# The FIXED contact points every admin login OTP is sent to — never taken
# from the login request itself. Both must be set or admin login cannot
# complete (fails closed, on purpose).
ADMIN_PHONE_NUMBER=+91XXXXXXXXXX
ADMIN_OWNER_EMAIL=owner@vivahtrousseau.com

# How long a code stays valid, how many wrong guesses are allowed before the
# whole challenge is discarded, and the minimum gap between resend requests.
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Twilio (phone OTP delivery via plain REST, no SDK dependency — see
# backend/src/utils/sms.js). Without these set, SMS sending fails soft: in
# development the code is logged to the server console only; in production
# nothing is delivered, so set these before going live. ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
